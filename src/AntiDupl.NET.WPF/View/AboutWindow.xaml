<Window x:Class="AntiDupl.NET.WPF.View.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource aboutwindow_title}"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <!-- Зеркал WF AboutProgramPanel: логотип + ссылка на проект, copyright,
         таблица «Компонент | Версия» (inset-рамки), ОК по центру -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Логотип 32x32 (Icon.ico) + имя проекта со ссылкой на сайт (как WF CreateLogotype) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Image Source="../Image/wf/Icon.ico" Width="32" Height="32" VerticalAlignment="Center"/>
            <TextBlock VerticalAlignment="Center" FontSize="16" Margin="6,0,0,0">
                <Hyperlink Command="{Binding OpenUrlCommand}" CommandParameter="{Binding Site}">
                    <Run Text="{Binding ProductName, Mode=OneWay}"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- Copyright (3 строки, локализация — aboutwindow_copyright0..2, зеркало WF) -->
        <TextBlock Grid.Row="1" Text="{DynamicResource aboutwindow_copyright0}"
                   HorizontalAlignment="Center" FontSize="12" Margin="0,10,0,0"/>
        <TextBlock Grid.Row="2" Text="{DynamicResource aboutwindow_copyright1}"
                   HorizontalAlignment="Center" FontSize="12"/>
        <TextBlock Grid.Row="3" Text="{DynamicResource aboutwindow_copyright2}"
                   HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,10"/>

        <!-- Таблица «Компонент | Версия» (inset-рамки, как WF TableLayoutPanel CellBorderStyle.Inset) -->
        <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1">
            <StackPanel>
                <!-- Шапка (жирная, как WF: Component / Version) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,1">
                        <TextBlock Text="{DynamicResource aboutwindow_column_Component}"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Padding="2"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="0,0,0,1">
                        <TextBlock Text="{DynamicResource aboutwindow_column_Version}"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Padding="2"/>
                    </Border>
                </Grid>
                <!-- Строки компонентов: имя — ссылка (tooltip = URL, как WF LinkLabel) -->
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,1">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Padding="2">
                                        <Hyperlink Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding Url}"
                                                   ToolTip="{Binding Url}">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Version}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Padding="2"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ОК по центру (зеркало WF: колонки 50% / auto / 50%) -->
        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" MinWidth="80"
                    Content="{DynamicResource aboutwindow_button_OK}"
                    Command="{Binding CloseCommand}" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>