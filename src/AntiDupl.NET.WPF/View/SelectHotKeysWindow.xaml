<Window x:Class="AntiDupl.NET.WPF.View.SelectHotKeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource selecthotkeys_title}"
        Height="360" Width="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  x:Name="HotKeysDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  ItemsSource="{Binding Rows}"
                  MinHeight="200">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource selecthotkeys_column_Action}"
                                    Binding="{Binding ActionName, Mode=OneWay}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="{DynamicResource selecthotkeys_column_Enabled}" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{DynamicResource selecthotkeys_column_Key}" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox x:Name="keyBox"
                                     Text="{Binding KeyDisplay, Mode=OneWay}"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False"
                                     ToolTip="{DynamicResource selecthotkeys_hint}"
                                     PreviewKeyDown="OnKeyBoxPreviewKeyDown"
                                     GotFocus="OnKeyBoxGotFocus"
                                     Tag="{Binding}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Setter Property="ToolTip" Value="{DynamicResource selecthotkeys_invalid}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource selecthotkeys_button_SetDefault}"
                    Width="110" Margin="0,0,8,0" Click="OnSetDefaultClick"/>
            <Button Content="{DynamicResource selecthotkeys_button_OK}"
                    Width="80" Margin="0,0,8,0"
                    Command="{Binding OkCommand}"
                    IsEnabled="{Binding CanOk}"/>
            <Button Content="{DynamicResource selecthotkeys_button_Cancel}"
                    Width="80" Command="{Binding CloseCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>